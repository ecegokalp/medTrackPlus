rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: only own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Dispenser: authenticated users who are owner, secondary, or read_only
    match /dispenser/{macAddress} {
      allow read: if request.auth != null
        && (resource.data.owner_mail == request.auth.token.email
            || request.auth.token.email in resource.data.secondary_mails
            || request.auth.token.email in resource.data.read_only_mails);
      allow write: if request.auth != null
        && resource.data.owner_mail == request.auth.token.email;

      // Verifications subcollection
      match /verifications/{verificationId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null;
        allow delete: if false;
      }

      // Logs subcollection
      match /logs/{logId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }
    }

    // Patients (device-free mode): virtual care profiles identified by
    // a generated 'patient_<uuid>' ID instead of a MAC address.
    // Same role hierarchy as dispenser: owner / secondary / read_only.
    match /patients/{patientId} {
      allow read: if request.auth != null
        && (resource.data.owner_mail == request.auth.token.email
            || request.auth.token.email in resource.data.secondary_mails
            || request.auth.token.email in resource.data.read_only_mails);
      // Creator must register themselves as owner.
      allow create: if request.auth != null
        && request.resource.data.owner_mail == request.auth.token.email;
      // Owner and secondary caregivers can edit medications/config;
      // ownership transfer is not allowed.
      allow update: if request.auth != null
        && (resource.data.owner_mail == request.auth.token.email
            || request.auth.token.email in resource.data.secondary_mails)
        && request.resource.data.owner_mail == resource.data.owner_mail;
      allow delete: if request.auth != null
        && resource.data.owner_mail == request.auth.token.email;

      // Verifications subcollection (same shape as dispenser)
      match /verifications/{verificationId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null;
        allow delete: if false;
      }

      // Logs subcollection (same shape as dispenser)
      match /logs/{logId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }
    }
  }
}